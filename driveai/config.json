{
  "system": {
    "name": "DriveAI",
    "version": "1.0.0",
    "environment": "College/Seminar Research Presentation"
  },
  "model": {
    "primary_model_path": "yolov8n.pt",
    "fallback_model_path": "perception/models/yolov8n.pt",
    "segmentation_model_path": "perception/models/runs_idd/idd_road_seg/weights/best.pt",
    "device": "cpu",
    "input_size": 640,
    "confidence_threshold": 0.35,
    "iou_threshold": 0.45,
    "inference_fps_limit": 30
  },
  "camera": {
    "default_source": 0,
    "available_sources": [
      {"id": "webcam_0", "name": "Live Primary Webcam (Device 0)", "type": "webcam", "index": 0},
      {"id": "webcam_1", "name": "Secondary Camera (Device 1)", "type": "webcam", "index": 1},
      {"id": "prerecorded_demo", "name": "Prerecorded Indian Road Video (Demo)", "type": "video", "path": "perception/perception_simulation_demo.mp4"}
    ],
    "resolution": {"width": 640, "height": 480}
  },
  "simulation": {
    "total_route_km": 50.0,
    "default_preset": "village_rural",
    "presets": {
      "village_rural": {
        "name": "Indian Village Rural Road",
        "description": "Winding undivided village road with farm tractors, auto-rickshaws, stray cattle & thatched mud huts",
        "traffic_density": 0.6,
        "speed_limit_kmh": 40
      },
      "busy_city": {
        "name": "Busy Mixed Traffic",
        "description": "Chaotic mixed traffic with auto-rickshaws, pedestrians, tractors & buses",
        "traffic_density": 0.8,
        "speed_limit_kmh": 40
      },
      "heavy_challenge": {
        "name": "Unstructured Road Challenge",
        "description": "Severe congestion, stray cattle on road edges & agricultural tractors",
        "traffic_density": 1.0,
        "speed_limit_kmh": 30
      }
    },
    "vehicle": {
      "wheelbase": 2.7,
      "width": 1.8,
      "length": 4.2,
      "max_speed_kmh": 80.0,
      "max_steer_deg": 25.0,
      "acceleration_rate": 12.0,
      "braking_rate": 28.0,
      "emergency_braking_rate": 45.0
    }
  },
  "database": {
    "mongodb_uri": "",
    "database_name": "driveai_telemetry",
    "enable_mongodb": true,
    "connection_timeout_ms": 2500
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8000
  }
}
